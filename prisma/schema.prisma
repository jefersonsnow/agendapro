generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Salon {
  id               String        @id @default(uuid())
  owner_id         String
  name             String
  slug             String        @unique
  description      String?       @db.Text
  address          String?
  phone            String?
  email            String?
  logo_url         String?
  cover_url        String?
  working_hours    String?       @db.Text
  settings         String?       @db.Text
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  plan             String        @default("minimo")
  status           String        @default("active")
  locale           String        @default("pt")
  timezone         String        @default("Europe/Lisbon")
  translations     String?
  trial_ends_at    DateTime?
  nif              String?
  color_palette    String        @default("default")

  appointments     Appointment[]
  cash_closings    CashClosing[]
  clients          Client[]
  products         Product[]
  owner            User          @relation("SalonOwner", fields: [owner_id], references: [id])
  services         Service[]
  staff            Staff[]
  transactions     Transaction[]
  users_usersalons User[]        @relation("usersalons")
  audit_logs       AuditLog[]
  support_tickets  SupportTicket[]
  related_users    User[]        @relation("UserToSalon")

  @@index([owner_id])
  @@map("salons")
}

model User {
  id                String    @id @default(uuid())
  salon_id          String?
  name              String?
  email             String?
  emailVerified     DateTime?
  password          String?
  image             String?
  role              String    @default("owner")
  locale            String    @default("pt")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  accounts          Account[]
  ownedSalons       Salon[]   @relation("SalonOwner")
  sessions          Session[]
  salons_usersalons Salon[]   @relation("usersalons")
  audit_logs        AuditLog[]
  salon             Salon?    @relation("UserToSalon", fields: [salon_id], references: [id], onDelete: Cascade)

  @@unique([email, salon_id])
  @@index([salon_id])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt


  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Staff {
  id              String         @id @default(uuid())
  salon_id        String
  user_id         String?        @unique
  name            String
  email           String?
  phone           String?
  role            String         @default("professional")
  avatar_url      String?
  bio             String?        @db.Text
  working_hours   String?        @db.Text
  is_active       Boolean        @default(true)
  color           String         @default("#0D9488")
  created_at      DateTime       @default(now())
  appointments    Appointment[]
  salon           Salon          @relation(fields: [salon_id], references: [id], onDelete: Cascade)
  services        StaffService[]
  transactions    Transaction[]

  @@index([salon_id])
  @@map("staff")
}

model Service {
  id               String         @id @default(uuid())
  salon_id         String
  name             String
  description      String?        @db.Text
  duration_minutes Int
  price            Decimal        @db.Decimal(10, 2)
  category         String         @default("Geral")
  image_url        String?
  is_active        Boolean        @default(true)
  display_order    Int            @default(0)
  translations     String?
  created_at       DateTime       @default(now())
  appointments     Appointment[]
  salon            Salon          @relation(fields: [salon_id], references: [id], onDelete: Cascade)
  staff            StaffService[]

  @@index([salon_id])
  @@map("services")
}

model Product {
  id             String        @id @default(uuid())
  salon_id       String
  name           String
  description    String?       @db.Text
  price          Decimal       @db.Decimal(10, 2)
  stock_quantity Int           @default(0)
  category       String        @default("Geral")
  image_url      String?
  is_active      Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  salon          Salon         @relation(fields: [salon_id], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([salon_id])
  @@map("products")
}

model StaffService {
  staff_id         String
  service_id       String
  commission_value Decimal? @db.Decimal(10, 2)
  created_at       DateTime @default(now())
  service          Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  staff            Staff   @relation(fields: [staff_id], references: [id], onDelete: Cascade)


  @@id([staff_id, service_id])
  @@index([service_id])
  @@map("staff_services")
}

model Client {
  id             String        @id @default(uuid())
  salon_id       String
  name           String
  email          String?
  phone          String?
  address        String?
  nif            String?
  notes          String?       @db.Text
  loyalty_points Int           @default(0)
  total_spent    Decimal       @default(0.00) @db.Decimal(10, 2)
  visit_count    Int           @default(0)
  created_at     DateTime      @default(now())
  last_visit     DateTime?
  password       String?
  appointments   Appointment[]
  salon          Salon         @relation(fields: [salon_id], references: [id], onDelete: Cascade)

  @@index([salon_id])
  @@map("clients")
}

model Appointment {
  id           String        @id @default(uuid())
  salon_id     String
  client_id    String?
  staff_id     String
  service_id   String?
  starts_at    DateTime
  ends_at      DateTime
  status       String        @default("pending")
  price        Decimal       @db.Decimal(10, 2)
  notes        String?       @db.Text
  source       String        @default("online")
  is_break     Boolean       @default(false)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  client       Client?       @relation(fields: [client_id], references: [id])
  salon        Salon         @relation(fields: [salon_id], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [service_id], references: [id])
  staff        Staff         @relation(fields: [staff_id], references: [id])
  transactions Transaction[]

  @@index([client_id])
  @@index([salon_id, starts_at])
  @@index([salon_id, status])
  @@index([salon_id, starts_at, status])
  @@index([service_id])
  @@index([staff_id])
  @@map("appointments")
}

model Transaction {
  id             String       @id @default(uuid())
  salon_id       String
  appointment_id String?
  staff_id       String?
  type           String
  amount         Decimal      @db.Decimal(10, 2)
  description    String?
  payment_method String       @default("cash")
  created_at     DateTime     @default(now())
  product_id     String?
  appointment    Appointment? @relation(fields: [appointment_id], references: [id])
  product        Product?     @relation(fields: [product_id], references: [id])
  salon          Salon        @relation(fields: [salon_id], references: [id], onDelete: Cascade)
  staff          Staff?       @relation(fields: [staff_id], references: [id])

  @@index([appointment_id])
  @@index([product_id])
  @@index([salon_id, created_at])
  @@index([salon_id, type])
  @@index([staff_id])
  @@map("transactions")
}

model CashClosing {
  id              String    @id @default(uuid())
  salon_id        String
  opened_at       DateTime  @default(now())
  closed_at       DateTime?
  opening_balance Decimal   @default(0.00) @db.Decimal(10, 2)
  closing_balance Decimal?  @db.Decimal(10, 2)
  total_income    Decimal   @default(0.00) @db.Decimal(10, 2)
  total_expense   Decimal   @default(0.00) @db.Decimal(10, 2)
  status          String    @default("open")
  notes           String?   @db.Text
  created_at      DateTime  @default(now())
  salon           Salon     @relation(fields: [salon_id], references: [id], onDelete: Cascade)

  @@index([salon_id])
  @@map("cash_closings")
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  content    String   @db.Text
  type       String   @default("info")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("announcements")
}

model AuditLog {
  id         String   @id @default(uuid())
  salon_id   String?
  user_id    String?
  action     String   // ex: "create_appointment", "delete_client", "update_settings"
  entity     String   // ex: "appointment", "client", "salon"
  entity_id  String?  // ID do recurso afetado
  details    String?  @db.Text // JSON string com detalhes da mudança
  created_at DateTime @default(now())
  salon      Salon?   @relation(fields: [salon_id], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([salon_id])
  @@index([user_id])
  @@map("audit_logs")
}

model GlobalConfig {
  id             String   @id @default("singleton")
  landing_page   String?  @db.Text // JSON: heroTitle, heroDesc, prices, etc.
  kiwify_configs  String?  @db.Text // JSON: webhookSecret, activeProducts, etc.
  stripe_configs  String?  @db.Text // JSON: secretKey, publishableKey, webhookSecret, priceBasicId, pricePremiumId
  support_config  String?  @db.Text // JSON: whatsappNumber, etc.
  promotion_config String? @db.Text // JSON: trialPremiumActive, promoText, etc.
  seo_config      String?  @db.Text // JSON: metaTitle, metaDesc, fbPixel, etc.
  sales_page_config String? @db.Text // JSON: videoUrl, headline, subheadline, timerDate, fbPixel, googlePixel
  welcome_email_config String? @db.Text // JSON: enableExtraContent, extraHtmlContent
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("global_configs")
}

model SupportTicket {
  id          String   @id @default(uuid())
  salon_id    String
  subject     String
  message     String   @db.Text
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("medium") // low, medium, high
  response    String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  salon       Salon    @relation(fields: [salon_id], references: [id], onDelete: Cascade)

  @@index([salon_id])
  @@map("support_tickets")
}

model PendingRegistration {
  id             String   @id @default(uuid())
  email          String
  password       String
  name           String
  salon_name     String
  address        String?
  phone          String?
  nif            String?
  plan           String
  created_at     DateTime @default(now())
  
  @@map("pending_registrations")
}
